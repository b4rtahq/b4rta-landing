---
import Base from '../layouts/Base.astro';
import { notes, principles, scope, statusRows } from '../data';
const scopeIds = ['house', 'tools', 'money', 'system'];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Public build log</p>
        <h1>Old house.<br />Real budget.<br />No fake luxury.</h1>
        <p class="lead">I’m turning an old house into a usable family base — one fix, one tool and one money decision at a time. This is the record of what works, what fails and what I would actually do again.</p>
        <div class="hero-actions">
          <a class="btn" href="/notes">Read the log</a>
          <a class="btn btn-secondary" href="/about">Start here</a>
        </div>
        <div class="hero-points" aria-label="B4RTA operating focus">
          <span>Livable first</span>
          <span>Buy less junk</span>
          <span>Track the money</span>
          <span>Pretty later</span>
        </div>
      </div>

      <aside class="hero-panel" aria-label="B4RTA base status">
        <div class="panel-topline">
          <span>Base status</span>
          <strong>Phase 01</strong>
        </div>
        <div class="mark-stage">
          <img src="/brand/b4rta-mark.png" alt="B4RTA apex mark" />
        </div>
        <div class="status-table">
          {statusRows.map(([label, value]) => (
            <div class="status-row">
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
        <div class="panel-footer">
          <span>Rise above noise.</span>
          <span>Built in public.</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-tight">
    <nav class="wrap signal-strip" aria-label="B4RTA build areas">
      <a href="#house"><span>01</span>House</a>
      <a href="#tools"><span>02</span>Tools</a>
      <a href="#money"><span>03</span>Money</a>
      <a href="#system"><span>04</span>System</a>
    </nav>
  </section>

  <section class="section section-current">
    <div class="wrap current-card">
      <div>
        <p class="section-label">Current phase</p>
        <h2>Make it livable before making it pretty.</h2>
      </div>
      <div class="current-copy">
        <p>The first win is not a perfect house. It is a house that works: dry rooms, safe basics, usable tools, controlled spending and fewer stupid surprises.</p>
        <a class="text-link" href="/notes">Latest notes <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap section-head">
      <div>
        <p class="section-label">What this is</p>
        <h2>Real build. Clear record.</h2>
      </div>
      <p class="section-copy">Not a glossy renovation fantasy. The useful parts are the decisions: what to fix first, what to buy, what to skip and where the money really goes.</p>
    </div>
    <div class="wrap scope-grid">
      {scope.map((item, index) => (
        <article class="scope-card" id={scopeIds[index]}>
          <span>{item.kicker}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap split-feature">
      <div>
        <p class="section-label">Position</p>
        <h2>Nice design. Real subject matter.</h2>
      </div>
      <div class="feature-copy">
        <p>The site can look premium, but the content stays grounded: old house, real constraints, family base, tools, costs and honest trade-offs.</p>
        <p>No fake luxury. No pretending the budget is infinite. No acting like every problem can be solved with a mood board.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap section-head compact-head">
      <div>
        <p class="section-label">Rules</p>
        <h2>Rules I actually use.</h2>
      </div>
      <a class="text-link" href="/principles">All principles <span>→</span></a>
    </div>
    <div class="wrap principle-list">
      {principles.slice(0, 4).map(([number, title, copy]) => (
        <article class="principle-row">
          <span class="principle-number">{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-notes">
    <div class="wrap notes-header">
      <div>
        <p class="section-label">Latest notes</p>
        <h2>Notes from the build.</h2>
      </div>
      <a class="text-link" href="/notes">View build log <span>→</span></a>
    </div>
    <div class="wrap notes-list">
      {notes.slice(0, 4).map((note) => (
        <a class="note-item" href="/notes">
          <span class="note-date">{note.date}</span>
          <span class="note-body">
            <strong>{note.title}</strong>
            <span>{note.text}</span>
          </span>
          <span class="note-tags">{note.tags}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section cta-section">
    <div class="wrap cta-box">
      <div>
        <p class="section-label">Manifesto</p>
        <h2>Build the base first.</h2>
        <p>The mission is simple: make a real home base, keep the money under control and document the decisions clearly.</p>
      </div>
      <a class="btn" href="/manifesto">Read the manifesto</a>
    </div>
  </section>
</Base>
