---
import '../styles/global.css';
const { title = 'B4RTA // Systems. Constraints. Long horizons.', description = 'Public notes on systems, incentives, decision-making and long-horizon thinking.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070A" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">B4RTA //</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/notes" aria-current={path.startsWith('/notes') ? 'page' : undefined}>Notes</a>
          <a href="/principles" aria-current={path.startsWith('/principles') ? 'page' : undefined}>Principles</a>
          <a href="/manifesto" aria-current={path.startsWith('/manifesto') ? 'page' : undefined}>Manifesto</a>
          <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <div class="footer-mark">B4RTA //</div>
          <div class="footer-small">Systems. Constraints. Long horizons.</div>
        </div>
        <div class="footer-links">
          <a href="https://x.com/_B4RTA" target="_blank" rel="noreferrer">X</a>
          <span>© 2026 B4RTA</span>
        </div>
      </div>
    </footer>
  </body>
</html>
